# ARK Print Server Configuration

# Server Configuration
PORT=8099
HOST=0.0.0.0

# Printer Configuration
PRINTER_IP=10.1.55.150
PRINTER_PORT=9100

# Security Token (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_TOKEN=your-secure-token-here

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Queue Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=2000
